{
  "name": "@judicialsync/api",
  "version": "0.1.0",
  "private": true,
  "description": "JudicialSync Platform Core — identity/ABAC, shared case model, audit trail, security baseline",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:assurance": "jest --config jest.assurance.config.js --runInBand",
    "test:auth": "jest --config jest.auth.config.js --runInBand",
    "test:policy": "jest --config jest.policy.config.js --runInBand",
    "test:integrity": "jest --config jest.integrity.config.js --runInBand",
    "test:files": "node --experimental-vm-modules node_modules/.bin/jest --config jest.files.config.js --runInBand",
    "test:case": "jest --config jest.case.config.js --runInBand",
    "test:grants": "jest --config jest.grants.config.js --runInBand",
    "db:migrate": "DATABASE_URL=$MIGRATION_DATABASE_URL prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:emit": "tsx scripts/emit-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.0.0",
    "file-type": "^19.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jose": "^4.15.9",
    "openid-client": "^5.7.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@testcontainers/postgresql": "^10.13.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "otplib": "^12.0.1",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
