# =============================================================================
# JudicialSync — Phase 1 environment contract
# =============================================================================
#
# This file is the COMPLETE, AUTHORITATIVE list of every environment variable
# the Phase 1 stack consumes. It is owned exclusively by plan 01-01; plans
# 01-02 through 01-15 CONSUME these variables and MUST NOT edit this file.
# If you are reading the repository to learn what the system needs, this is
# the one place that answer lives.
#
# SECRETS: every variable marked `[SECRET]` is resolved in production from
# AWS Secrets Manager or Azure Key Vault (Government) per
# `project_specs/TechArch/05-tech-stack.md` §8.4 — "No credentials embedded in
# code or container images". The values below are blank or local-development
# safe ONLY. Never commit a real value to this file.
#
# Copy to `.env` for local development:  cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------

# HTTP port the Platform Core API binds. Consumer: apps/api/src/main.ts (01-01).
PORT=3000

# Node environment. Consumer: apps/api/src/main.ts, NestJS ConfigModule (01-01).
# Use `development` locally; `production` only behind real TLS termination.
NODE_ENV=development

# Externally reachable base URL of this API, used to construct absolute
# callback URLs for the OIDC flow. Consumer: identity module (01-06).
# NOTE: never use this to build URLs handed back to a browser for
# same-origin resources — emit relative paths for those.
PUBLIC_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Data stores
# -----------------------------------------------------------------------------

# Runtime PostgreSQL connection for the APPLICATION database role, `app_rw`.
# This role deliberately holds NO UPDATE/DELETE grant on audit_events and no
# DELETE grant on case-model tables (TechArch/04-security.md §7.3/§7.4).
# The role is created by infra/db/init/01-roles.sql (01-03) and PrismaService
# asserts at boot that it is the role actually in use — connecting as app_dba
# would silently void every grant above.
# Consumers: Prisma client (01-03), raw SQL clients (01-14).
DATABASE_URL=postgresql://app_rw:app_rw_local_dev@localhost:5432/judicialsync?schema=platform

# PostgreSQL connection for the MIGRATION role `app_dba`, which DOES hold DDL
# rights and is never used by running request-handling code.
# Separate from DATABASE_URL so the running application can never alter schema
# or escalate its own grants. Consumer: `npm run db:migrate` (01-03).
# [SECRET] in production.
MIGRATION_DATABASE_URL=postgresql://app_dba:app_dba_local_dev@localhost:5432/judicialsync?schema=platform

# Redis 7 connection. Consumers: session short-cache window (01-06),
# BullMQ queue backend for the audit integrity job (01-12), rate limiting (01-11).
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Policy Decision Point (OPA)
# -----------------------------------------------------------------------------

# Base URL of the Open Policy Agent container serving the Rego policy bundle.
# Consumer: PDP client in apps/api/src/modules/policy (01-07).
OPA_URL=http://localhost:8181

# Hard timeout for a single PDP evaluation, in milliseconds. On timeout the
# request is DENIED with 503 SECURITY_POLICY_UNAVAILABLE — fail closed, never
# fail open (FRD/Y2-errors.md principle 1). Consumer: policy module (01-07).
PDP_TIMEOUT_MS=2000


# -----------------------------------------------------------------------------
# Identity provider (OIDC / Keycloak)
# -----------------------------------------------------------------------------

# OIDC issuer discovery URL for the court IdP. Locally this is the Keycloak
# container's realm. Swapping in a court's real IdP is a change to THIS value,
# not a code change. Consumer: identity module (01-06).
OIDC_ISSUER_URL=http://localhost:8080/realms/judicialsync

# OIDC client identifier registered with the IdP for the internal application
# audience. The external attorney portal (Phase 4) uses a structurally separate
# client/audience. Consumer: identity module (01-06).
OIDC_CLIENT_ID=judicialsync-internal

# [SECRET] OIDC client secret. Production: AWS Secrets Manager / Azure Key Vault.
# Consumer: identity module (01-06).
# NOTE: unlike the other [SECRET] placeholders in this file, this value is NOT
# safe to auto-generate. It must be byte-identical to the "secret" field baked
# into the committed local-dev Keycloak realm export
# (infra/keycloak/realm-judicialsync.json, clientId "judicialsync-internal") —
# Keycloak is the OTHER party in this exchange and already has its own fixed
# copy. A wrapper that replaces this placeholder with a freshly generated
# value breaks every login with "unauthorized_client (Invalid client or
# Invalid client credentials)" even though the API itself boots cleanly.
OIDC_CLIENT_SECRET=judicialsync-local-dev-client-secret

# Redirect URI registered with the IdP for the authorization-code callback.
# Must exactly match the IdP client configuration. Consumer: identity (01-06).
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# [SECRET] Keycloak administrative credentials, used ONLY by the local
# development Compose stack and the realm/user seed script. These never exist
# in a production deployment — a real court IdP is externally administered.
# Consumers: docker-compose (01-04), seed script (01-04).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD


# -----------------------------------------------------------------------------
# Service-to-service authentication
# -----------------------------------------------------------------------------

# [SECRET] Shared token authenticating internal service-to-service calls, most
# importantly POST /audit/events, which Y1a marks "internal service-to-service
# only — not user-invokable". Consumers: audit module (01-05).
INTERNAL_SERVICE_TOKEN=


# -----------------------------------------------------------------------------
# Bootstrap (empty-system exception)
# -----------------------------------------------------------------------------
#
# An empty system cannot satisfy the two-person approval rule, so a controlled
# bootstrap exists. It is a DEVELOPMENT-CONSTRAINT WORKAROUND requiring
# security/stakeholder validation before production — see docs/ASSUMPTIONS.md
# ASM-03. Bootstrap identities come from these explicit variables and must
# NEVER be derived from the first authenticated user.

# Comma-separated IdP subject identifiers granted bootstrap administrator
# capability. Consumer: bootstrap path (01-08).
BOOTSTRAP_ADMIN_SUBJECTS=

# Comma-separated IdP subject identifiers that may APPROVE bootstrap grants.
# Must be disjoint from BOOTSTRAP_ADMIN_SUBJECTS so the bootstrap path cannot
# self-approve. Consumer: bootstrap path (01-08).
BOOTSTRAP_APPROVER_SUBJECTS=


# -----------------------------------------------------------------------------
# Malware scanning (ClamAV)
# -----------------------------------------------------------------------------

# ClamAV daemon host/port. The scan is a hard gate: a file that fails the scan
# is rejected BEFORE storage (F13). There is no no-op scanner.
# Consumer: files module (01-10).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Hard timeout for a single scan, in milliseconds. A timeout is treated as a
# scan FAILURE (fail closed), not as a pass. Consumer: files module (01-10).
CLAMAV_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Object storage (S3-compatible — MinIO locally, S3 GovCloud / Azure in prod)
# -----------------------------------------------------------------------------
#
# These are SERVER-SIDE ONLY. The endpoint must never appear in a browser-facing
# response or a client-exposed variable: file bytes move through the
# application's own authenticated API routes, never via a presigned URL handed
# to the browser.

# S3-compatible endpoint. Leave blank to use the AWS default endpoint for
# S3_REGION. Consumer: files module (01-10).
S3_ENDPOINT=http://localhost:9000

# Object store region. Consumer: files module (01-10).
S3_REGION=us-east-1

# Bucket holding file references and generated packages. Consumer: files (01-10).
S3_BUCKET=judicialsync-files

# [SECRET] Object store credentials. Production: AWS Secrets Manager /
# Azure Key Vault, or better, an instance role with no static credential at all.
# Consumer: files module (01-10).
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY

# [SECRET] Base64 KMS key backing MinIO server-side encryption locally, standing
# in for the dedicated KMS that TechArch/04-security.md §7.5 requires in
# production. Encryption at rest is asserted via HeadObject (01-10).
# Consumer: docker-compose MinIO service (01-04).
# NOTE: MinIO requires this to decode to EXACTLY 32 bytes (AES-256) — unlike
# the other [SECRET] placeholders above, this is NOT a `CHANGE_ME`-style value
# the wrapper's generic secret generator can safely replace (that generator
# strips to alphanumeric-only and does not guarantee valid/correctly-sized
# base64). This is a fixed LOCAL-DEV-ONLY key, not a production credential.
MINIO_KMS_KEY_B64=TNhTzaJagdiykuIxyvi9kIPQTZBrcpzwOiE+SLSAHMA=


# -----------------------------------------------------------------------------
# Audit integrity verification
# -----------------------------------------------------------------------------

# Interval between hash-chain verification sweeps, in milliseconds.
# Consumer: BullMQ integrity job (01-12).
AUDIT_INTEGRITY_INTERVAL_MS=3600000

# Master switch for the scheduled integrity job. Set `false` in test runs so
# the suite controls invocation explicitly; `true` in any real environment.
# Disabling it does NOT disable chain writing — only the periodic check.
# Consumer: BullMQ integrity job (01-12).
AUDIT_INTEGRITY_SCHEDULE_ENABLED=true


# -----------------------------------------------------------------------------
# Transport and limits
# -----------------------------------------------------------------------------

# Path to an additional CA bundle, needed when a court IdP, OPA, or object store
# presents an internally-issued certificate. Read natively by Node 20.
# Consumer: Node runtime (all modules).
NODE_EXTRA_CA_CERTS=

# Maximum accepted upload size in bytes. Enforced before the file is buffered,
# so an oversized upload is rejected without consuming memory.
# Consumer: files module (01-10). Default 52428800 = 50 MiB.
MAX_UPLOAD_BYTES=52428800
